      "node": {
        "fields": ["id", "name", "categories", "labels", "attributes"]
      },
      "hyperedge": {
        "fields": ["id", "type", "relation", "connects", "constraints", "notes"]
      },
      "categories": [
        "Concept", "Property", "Process", "Discipline", "Level", "TaxonRank", "Domain", "ExampleOrganism", "Structure", "Molecule", "Function", "Environment", "EthicalCase", "LegalConcept", "Evidence", "PopulationUnit"
      ]
