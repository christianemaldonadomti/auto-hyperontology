# ==============================================================================
# Plantilla de Variables de Entorno (.env.example)
# Copia este archivo a `.env` (que está ignorado en .gitignore) para no escribir
# tu usuario/token cada vez:
#   cp .env.example .env
# ==============================================================================

# 1. Credenciales de GitHub (Para ./push_to_github.sh sin pedir contraseña)
GITHUB_USERNAME=christianemaldonadomti
GITHUB_TOKEN=ghp_pega_aqui_tu_personal_access_token

# 2. Credenciales de PyPI (Para publicar con twine sin pedir contraseña)
TWINE_USERNAME=__token__
TWINE_PASSWORD=pypi-pega_aqui_tu_token_de_pypi

# 3. Configuración por defecto de Ollama / ngrok para Auto-Hyperontology
OLLAMA_ENDPOINT=https://comic-hugely-eft.ngrok-free.app
OLLAMA_EXTRACTION_MODEL=qwen3.8-flash-next:125b-a6b-q4_K_M
OLLAMA_REASONING_MODEL=intuyt:macro
